license: ["CC-BY-4.0", "MIT"]
repository-code: "https://github.com/<your-username>/causal-uplift-targeting-guide"
keywords:
  - uplift modeling
  - causal inference
  - randomized experiments
  - CDFI
  - community lending
  - outreach targeting
